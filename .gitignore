.venv/
__pycache__/
*.pyc

# The warehouse file is generated by the pipeline (ingestion + dbt), so it
# doesn't belong in version control -- anyone cloning the repo regenerates
# it locally with `make pipeline`.
warehouse/

# dbt build artifacts
finance_dbt/target/
finance_dbt/logs/
finance_dbt/dbt_packages/

# If you later load your own real bank exports, keep them out of git --
# only the synthetic sample_transactions.csv should ever be committed.
data/raw/*.csv
!data/raw/sample_transactions.csv

# Encrypted real bank data (see scripts/encrypt_bank_csv.py) -- these are
# ciphertext, not plaintext, but there's no reason for them to be in the
# repo either. Gitignored wholesale, not just *.enc, so nothing dropped
# into this folder is ever one `git add -A` away from being committed.
data/private/

# Trained ML model -- generated by ml/train_categorizer.py, not source
ml/model/

# dbt anonymous-usage-stats id, regenerated per machine -- not useful to
# share and not sensitive, just machine-specific noise.
finance_dbt/.user.yml

.DS_Store
